# ⚠️ Modèle uniquement : ne jamais mettre de vraie valeur dans ce fichier (il est versionné).

# URL de connexion PostgreSQL (Neon ou autre hébergeur)
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE/neondb?sslmode=require"
DATABASE_DEMANDES_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE/demandes?sslmode=require"

# Port d'écoute du serveur
PORT=3001
NODE_ENV=production

# Secret partagé avec le portail (même valeur que AGILLY_API_SECRET côté front).
# 32 caractères minimum. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AGILLY_API_SECRET="a-generer"

# Origines navigateur autorisées (séparées par une virgule)
FRONTEND_URL="https://portal.agillycloud.net"

# Optionnel : e-mail(s) du VRAI PDG si son intitulé de poste n'est pas renseigné
# (jamais un compte de test). Par défaut, le PDG est reconnu par son poste.
# EMAILS_PDG="prenom.nom@agilly.net"

# Documentation Swagger en production (déconseillé)
# ACTIVER_SWAGGER=true
